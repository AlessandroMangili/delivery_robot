+void PCLLocalization::sendMapToOdomTransform(
+  const geometry_msgs::msg::TransformStamped & map_to_odom)
+{
+  if (map_odom_tf_future_s_ <= 0.0) {
+    broadcaster_.sendTransform(map_to_odom);
+    return;
+  }
+  geometry_msgs::msg::TransformStamped sent = map_to_odom;
+  sent.header.stamp = rclcpp::Time(map_to_odom.header.stamp, RCL_ROS_TIME) +
+    rclcpp::Duration::from_seconds(map_odom_tf_future_s_);
+  broadcaster_.sendTransform(sent);
+}
