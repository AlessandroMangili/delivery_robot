<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spatiotemporal_critic</name>
  <version>0.1.0</version>
  <description>
    Critic spazio-temporale per il controller MPPI di Nav2. Valuta le traiettorie
    contro la posizione FUTURA dei pedoni (predizione dal Kalman del tracker) e
    premia le manovre verso lo spazio libero laterale. Contributo di tesi.
  </description>
  <maintainer email="alessandro@example.com">alessandro</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>dynamic_tracker_msgs</depend>
  <depend>visualization_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- Dice a nav2_mppi_controller che questo pacchetto fornisce un critic -->
    <nav2_mppi_controller plugin="${prefix}/critics.xml" />
  </export>
</package>