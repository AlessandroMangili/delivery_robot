<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>husky_a100_description</name>
  <version>0.1.1</version>
  <description>Parametric URDF of the Clearpath Husky A100 (six wheels), with its sensors and the sensor drivers launch. Wheel mesh, wheel macro, materials and extras mechanism from husky/husky_description (noetic-devel, BSD).</description>
  <maintainer email="alessandro.mangili1@studenti.unimi.it">Alessandro</maintainer>
  <license>MIT</license>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
