<?xml version="1.0"?>
<!-- Derived from husky/husky_description (noetic-devel), Copyright (c) 2015 Clearpath Robotics, Inc., BSD license: see meshes/LICENSE.husky_description -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="a100_wheel" params="prefix x y radius width mass mesh_file mesh_d mesh_w mimic:=''">
    <link name="${prefix}_wheel_link">
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="${mass * (3 * radius**2 + width**2) / 12.0}" ixy="0" ixz="0"
                 iyy="${mass * radius**2 / 2.0}" iyz="0"
                 izz="${mass * (3 * radius**2 + width**2) / 12.0}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_file}"
                scale="${2.0 * radius / mesh_d} ${width / mesh_w} ${2.0 * radius / mesh_d}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder length="${width}" radius="${radius}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <xacro:if value="${mimic != ''}">
        <mimic joint="${mimic}" multiplier="1.0" offset="0.0"/>
      </xacro:if>
    </joint>
  </xacro:macro>

</robot>
