<?xml version="1.0"?>
<!--
  Plugin per Gazebo Fortress (default con ROS 2 Humble), inclusi solo con use_gazebo:=true.
  - DiffDrive comanda tutte e sei le ruote (tre per lato): Gazebo Fortress ignora i <mimic>,
    quindi le ruote centrali vanno elencate esplicitamente.
  - Pubblica odom e la TF odom -> base_footprint.
  - JointStatePublisher pubblica lo stato dei sei giunti ruota.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="a100_gazebo">
    <gazebo>
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>middle_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>middle_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>${T}</wheel_separation>
        <wheel_radius>${r}</wheel_radius>
        <max_linear_velocity>${dims['gazebo']['max_linear_velocity']}</max_linear_velocity>
        <min_linear_velocity>${-dims['gazebo']['max_linear_velocity']}</min_linear_velocity>
        <max_linear_acceleration>${dims['gazebo']['max_linear_acceleration']}</max_linear_acceleration>
        <min_linear_acceleration>${-dims['gazebo']['max_linear_acceleration']}</min_linear_acceleration>
        <odom_publish_frequency>${dims['gazebo']['odom_publish_frequency']}</odom_publish_frequency>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
      </plugin>
      <plugin filename="ignition-gazebo-joint-state-publisher-system"
              name="ignition::gazebo::systems::JointStatePublisher">
        <topic>joint_states</topic>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
