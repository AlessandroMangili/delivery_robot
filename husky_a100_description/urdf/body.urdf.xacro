<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="box_inertia" params="m x y z *origin">
    <inertial>
      <mass value="${m}"/>
      <xacro:insert_block name="origin"/>
      <inertia ixx="${m * (y**2 + z**2) / 12.0}" ixy="0" ixz="0"
               iyy="${m * (x**2 + z**2) / 12.0}" iyz="0"
               izz="${m * (x**2 + y**2) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="a100_box" params="xyz rpy size material">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><box size="${size}"/></geometry>
      <material name="${material}"/>
    </visual>
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><box size="${size}"/></geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="a100_tube" params="xyz yaw length radius material">
    <visual>
      <origin xyz="${xyz}" rpy="0 ${pi / 2} ${yaw}"/>
      <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      <material name="${material}"/>
    </visual>
    <collision>
      <origin xyz="${xyz}" rpy="0 ${pi / 2} ${yaw}"/>
      <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="a100_chassis">
    <xacro:property name="h1" value="${z_ch - gc}"/>
    <xacro:property name="h2" value="${H - z_ch}"/>
    <xacro:property name="dx" value="${(Lc - Lt) / 2.0}"/>
    <xacro:property name="hyp" value="${sqrt(dx**2 + h2**2)}"/>
    <xacro:property name="d" value="${dx * h2 / hyp}"/>
    <xacro:property name="cx" value="${(Lc + Lt) / 4.0 - 0.5 * d * h2 / hyp}"/>
    <xacro:property name="cz" value="${(z_ch + H) / 2.0 - 0.5 * d * dx / hyp - r}"/>

    <link name="base_link">
      <xacro:box_inertia m="${m_chassis}" x="${Lc}" y="${Wc}" z="${H - gc}">
        <origin xyz="0 0 ${(gc + H) / 2.0 - r}" rpy="0 0 0"/>
      </xacro:box_inertia>
      <xacro:a100_box xyz="0 0 ${(gc + z_ch) / 2.0 - r}" rpy="0 0 0"
                      size="${Lc} ${Wc} ${h1}" material="black"/>
      <xacro:a100_box xyz="0 0 ${(z_ch + H) / 2.0 - r}" rpy="0 0 0"
                      size="${Lt} ${Wc} ${h2}" material="black"/>
      <xacro:a100_box xyz="${cx} 0 ${cz}" rpy="0 ${atan2(-dx, h2)} 0"
                      size="${d} ${Wc} ${hyp}" material="yellow"/>
      <xacro:a100_box xyz="${-cx} 0 ${cz}" rpy="0 ${atan2(dx, h2)} 0"
                      size="${d} ${Wc} ${hyp}" material="yellow"/>
    </link>

    <link name="top_chassis_link"/>
    <joint name="top_chassis_joint" type="fixed">
      <parent link="base_link"/>
      <child link="top_chassis_link"/>
      <origin xyz="0 0 ${H - r}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="a100_side_rail" params="side sign">
    <link name="${side}_rail_link">
      <xacro:box_inertia m="${m_rail}" x="${Lr}" y="${t_rail}" z="${h_rail}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:box_inertia>
      <xacro:a100_box xyz="0 0 0" rpy="0 0 0" size="${Lr} ${t_rail} ${h_rail}" material="yellow"/>
    </link>
    <joint name="${side}_rail_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_rail_link"/>
      <origin xyz="0 ${sign * (W / 2.0 - t_rail / 2.0)} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="a100_bumper" params="name sign">
    <xacro:property name="rb" value="${db / 2.0}"/>
    <xacro:property name="xb" value="${L / 2.0 - rb}"/>
    <xacro:property name="ys" value="${W / 2.0 - rb}"/>
    <xacro:property name="delta" value="${ys - a_bump}"/>
    <xacro:property name="l_stub" value="${xb - Lr / 2.0 - delta}"/>
    <xacro:property name="l_ch" value="${delta * sqrt(2.0)}"/>
    <xacro:property name="x_com" value="${(2 * l_ch * (-delta / 2.0) + 2 * l_stub * (-(delta + l_stub / 2.0))) / (2 * a_bump + 2 * l_ch + 2 * l_stub)}"/>

    <link name="${name}_bumper_link">
      <xacro:box_inertia m="${m_bumper}" x="${delta + l_stub}" y="${2 * ys}" z="${db}">
        <origin xyz="${x_com} 0 0" rpy="0 0 0"/>
      </xacro:box_inertia>
      <xacro:a100_tube xyz="0 0 0" yaw="${pi / 2}" length="${2 * a_bump}" radius="${rb}" material="black"/>
      <xacro:a100_tube xyz="${-delta / 2.0} ${(a_bump + ys) / 2.0} 0" yaw="${atan2(delta, -delta)}"
                       length="${l_ch}" radius="${rb}" material="black"/>
      <xacro:a100_tube xyz="${-delta / 2.0} ${-(a_bump + ys) / 2.0} 0" yaw="${atan2(-delta, -delta)}"
                       length="${l_ch}" radius="${rb}" material="black"/>
      <xacro:a100_tube xyz="${-(delta + l_stub / 2.0)} ${ys} 0" yaw="0"
                       length="${l_stub}" radius="${rb}" material="black"/>
      <xacro:a100_tube xyz="${-(delta + l_stub / 2.0)} ${-ys} 0" yaw="0"
                       length="${l_stub}" radius="${rb}" material="black"/>
    </link>
    <joint name="${name}_bumper_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_bumper_link"/>
      <origin xyz="${sign * xb} 0 ${z_bump - r}" rpy="0 0 ${0 if sign > 0 else pi}"/>
    </joint>
  </xacro:macro>

</robot>
