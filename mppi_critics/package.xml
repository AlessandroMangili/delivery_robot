<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mppi_critics</name>
  <version>0.2.0</version>
  <description>
    Additional critics for the Nav2 MPPI controller: spatio-temporal pedestrian avoidance (time to collision and
    closeness against tracked pedestrians), detour around blocking obstacles, rotate-first, rotation dead zone,
    side choice, clearance and heading.
  </description>
  <maintainer email="alessandro@example.com">alessandro</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>dynamic_tracker_msgs</depend>
  <depend>visualization_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_mppi_controller plugin="${prefix}/critics.xml" />
  </export>
</package>
