<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mppi_critics</name>
  <version>0.2.0</version>
  <description>Additional critics for the Nav2 MPPI controller: anticipation of moving people (closeness and time to collision) and detour around obstacles that block the path.</description>
  <maintainer email="alessandro.mangili1@studenti.unimi.it">alessandro</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>dynamic_tracker_msgs</depend>
  <depend>visualization_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_mppi_controller plugin="${prefix}/critics.xml" />
  </export>
</package>
