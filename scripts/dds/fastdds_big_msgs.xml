<?xml version="1.0" encoding="UTF-8" ?>
<!-- Messaggi grandi (nuvole RSP128 da 7.3 MB, immagini 1920x1280 da 7.4 MB).
     Sullo stesso PC: memoria condivisa con segmento grande, niente frammenti UDP.
     Tra PC diversi: UDP con buffer socket grandi (serve anche sysctl, vedi README). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_big</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp_big</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>16777216</sendBufferSize>
      <receiveBufferSize>16777216</receiveBufferSize>
      <interfaceWhiteList>
        <address>192.168.131.2</address>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="big_msgs" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_big</transport_id>
        <transport_id>udp_big</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
