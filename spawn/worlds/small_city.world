    <!-- Lamp posts, very light -->
    <model name="lamp_1">
      <static>true</static>
      <pose>-18 4.3 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>4.5</length></cylinder></geometry><pose>0 0 2.25 0 0 0</pose></collision>
        <visual name="visual"><geometry><cylinder><radius>0.08</radius><length>4.5</length></cylinder></geometry><pose>0 0 2.25 0 0 0</pose><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
