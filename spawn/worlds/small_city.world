      <link name="link">
        <collision name="collision"><geometry><box><size>90 0.25 0.18</size></box></geometry><pose>0 -5.25 0.09 0 0 0</pose></collision>
        <visual name="visual"><geometry><box><size>90 0.25 0.18</size></box></geometry><pose>0 -5.25 0.09 0 0 0</pose><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Houses (simple boxes, low cost) -->
    <model name="house_1">
      <static>true</static>
      <pose>-30 11 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 6 5</size></box></geometry><pose>0 0 2.5 0 0 0</pose></collision>
        <visual name="visual"><geometry><box><size>8 6 5</size></box></geometry><pose>0 0 2.5 0 0 0</pose><material><ambient>0.85 0.65 0.55 1</ambient><diffuse>0.85 0.65 0.55 1</diffuse></material></visual>
